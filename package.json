{
  "name": "profino-telegram-bot",
  "version": "1.0.0",
  "description": "PROFINO Telegram Platform",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "test": "node --test",
    "pretest:postgres": "node -e \"if (!process.env.DATABASE_URL) { console.error('Set DATABASE_URL to a disposable PostgreSQL test database.'); process.exit(1); }\"",
    "test:postgres": "node --test src/*.postgres.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "grammy": "^1.30.0",
    "pg": "^8.16.3"
  },
  "license": "MIT"
}
