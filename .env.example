# Existing @PROFINO1bot only. Use its protected host setting; do not create a new bot or reuse its token in local/staging tests.
TELEGRAM_BOT_TOKEN=

# polling (default) or webhook. Webhook needs a public https address.
TELEGRAM_MODE=polling

# Webhook mode only: the app's public address, e.g. https://my-bot.fadehost.app
WEBHOOK_URL=
# Required in webhook mode. Inject a randomly generated value using the host secret store.
WEBHOOK_SECRET=
# Webhook mode: the port to listen on (FadeHost sets PORT for you).
PORT=8080

# PostgreSQL connection string from your hosting provider.
# Keep real credentials in the hosting environment; never commit them here.
DATABASE_URL=

# Database TLS: default 'disable' preserves existing private-network deployment behavior.
# Set verify-full ONLY after validating provider TLS and certificate requirements.
PROFINO_DB_TLS_MODE=disable
# Optional PEM certificate authority; set as a protected multiline environment secret.
# PROFINO_DB_TLS_CA_PEM=
